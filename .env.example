# Tên file template HTML mặc định hiển thị giao diện
HTML_TEMPLATE=index_chat.html

# Cấu hình máy chủ web Flask (tùy chọn)
HOST=0.0.0.0
PORT=5000

# Cấu hình AWS S3
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-1
AWS_S3_BUCKET_NAME=your_s3_bucket_name

# Cấu hình Supabase PostgreSQL
DIRECT_URL="postgresql://postgres:password@host:5432/postgres"
DATABASE_URL="postgresql://postgres:password@host:6543/postgres?sslmode=require"

# Cấu hình Telegram Alert Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id
